# Copy to .env (gitignored) and fill in only what this machine uses. Inspect loads .env automatically.

# Personal keys (Mac)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Azure AI Foundry (office machine): model names look like openai-api/foundry/<deployment>
FOUNDRY_BASE_URL=        # {endpoint}/openai/v1
FOUNDRY_API_KEY=

# vLLM on the 4090 (PC): model names look like openai-api/local/<served-model-name>
LOCAL_BASE_URL=http://localhost:8000/v1
LOCAL_API_KEY=local      # any non-empty value unless vLLM was started with --api-key
